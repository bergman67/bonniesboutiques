{
  "name": "wonderful-hertz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node -e \"const fs=require('fs'); fs.mkdirSync('.next/server/pages', {recursive: true});\" && next build && node -e \"const fs=require('fs'); ['bt_logo.jpg','logo.jpg','bt_logo_sm.webp'].forEach(f=>{if(fs.existsSync('public/'+f))fs.copyFileSync('public/'+f,'.next/'+f)}); if(fs.existsSync('.next/static'))fs.cpSync('.next/static','.next/_next/static',{recursive:true})\"",
    "start": "next start",
    "lint": "next lint",
    "test": "node scripts/run-e2e-tests.mjs",
    "verify-studio": "node scripts/verify-studio.mjs",
    "verify-cro": "node scripts/verify-cro-upgrades.mjs",
    "compile-episodes": "node scripts/compile-episodes.mjs",
    "record-promo": "node scripts/record-storefront-promo.mjs",
    "publish-socials": "node scripts/publish-socials.mjs",
    "track-metrics": "node scripts/track-metrics.mjs",
    "generate-episode": "node scripts/generate-ai-episode.mjs",
    "seed-manifest": "node scripts/seed-manifest-products.mjs",
    "setup-youtube": "node scripts/setup-youtube-oauth.mjs",
    "setup-instagram": "node scripts/setup-meta-tokens.mjs",
    "setup-tiktok": "node scripts/setup-tiktok-oauth.mjs",
    "postinstall": "prisma generate",
    "remove-bg": "node scripts/removeBackgrounds.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@imgly/background-removal-node": "^1.4.5",
    "@prisma/client": "^5.22.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@stripe/react-stripe-js": "^6.10.0",
    "@stripe/stripe-js": "^9.16.0",
    "@supabase/supabase-js": "^2.116.0",
    "dotenv": "^17.4.2",
    "gsap": "^3.15.0",
    "jpeg-js": "^0.4.4",
    "next": "14.2.35",
    "pngjs": "^7.0.0",
    "react": "^18",
    "react-dom": "^18",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.170.0",
