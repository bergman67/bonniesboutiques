generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String   @id @default(cuid())
  title       String
  description String?
  price       Float?
  imageUrl    String?
  isDraft     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StoreSettings {
  id                    String   @id @default("default")
  stripeSecretKey       String?
  stripePublishableKey  String?
  venmoHandle           String   @default("@BonniesBoutique")
  paypalEmail           String?
  enableStripe          Boolean  @default(true)
  enableVenmo           Boolean  @default(true)
  enablePaypal          Boolean  @default(true)
  shippingFlatRate      Float    @default(3.99)
  freeShippingThreshold Float    @default(20.00)
  adminPin              String?
  updatedAt             DateTime @updatedAt
}

model Order {
  id              String   @id @default(cuid())
  customerName    String
  customerEmail   String
  customerPhone   String?
  shippingAddress String
  paymentMethod   String
  paymentStatus   String   @default("pending") // pending, paid, fulfilled, cancelled
  stripeSessionId String?
  itemsJson       String   // JSON string of cart items
  subtotal        Float
  shippingCost    Float
  total           Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

